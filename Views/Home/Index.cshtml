@model List<GroceryStoreApp.Models.Product>
@{
    Layout = null;
    var searchQuery = ViewBag.SearchQuery as string ?? "";
    var selectedCategory = ViewBag.SelectedCategory as string ?? "All";
    var selectedSort = ViewBag.SelectedSort as string ?? "";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var isLoggedIn = User.Identity?.IsAuthenticated ?? false;
    var userName = User.Identity?.Name ?? "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>QuickBite Mart - 10-Minute Grocery Delivery</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#059669" />
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .blinkit-card { background: #ffffff; border: 1px solid #f1f5f9; box-shadow: 0 4px 20px rgba(0,0,0,0.03); transition: all 0.2s ease; }
        .blinkit-card:hover { box-shadow: 0 10px 30px rgba(5, 150, 105, 0.08); border-color: #a7f3d0; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        #splash-screen { transition: opacity 0.5s ease, visibility 0.5s ease; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased selection:bg-emerald-500 selection:text-white">

    <!-- Splash Screen Loading Animation -->
    <div id="splash-screen" class="fixed inset-0 z-50 bg-emerald-950 flex flex-col items-center justify-center text-white p-6">
        <div class="w-20 h-20 rounded-3xl bg-gradient-to-tr from-emerald-500 to-teal-400 flex items-center justify-center shadow-2xl animate-bounce mb-6">
            <i class="fa-solid fa-bolt text-4xl"></i>
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight mb-2">QuickBite <span class="text-emerald-400">Mart</span></h1>
        <p class="text-emerald-200 text-xs font-semibold tracking-widest uppercase mb-6">10-Minute Grocery Delivery</p>
        <div class="w-48 h-1.5 bg-emerald-900 rounded-full overflow-hidden">
            <div class="w-full h-full bg-emerald-400 animate-[pulse_1s_infinite]"></div>
        </div>
    </div>

    <!-- STRICT OUT-OF-SERVICE FULL-SCREEN BLOCKER ("We are coming soon here") -->
    <div id="oos-blocker" class="fixed inset-0 z-50 bg-emerald-950 flex flex-col items-center justify-center text-white p-6 text-center hidden">
        <div class="w-20 h-20 rounded-3xl bg-emerald-800 text-emerald-300 flex items-center justify-center text-3xl mb-6 shadow-2xl">
            <i class="fa-solid fa-store-slash"></i>
        </div>
        <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight mb-3">We are coming soon here!</h1>
        <p class="text-emerald-200 text-sm md:text-base max-w-lg mb-8 leading-relaxed">
            QuickBite Mart's 10-minute delivery is not yet operational in your city. We are expanding rapidly and our dark stores will be live near you very soon!
        </p>
        <button onclick="resetCitySelection()" class="bg-white text-emerald-950 px-6 py-3.5 rounded-2xl font-extrabold text-sm shadow-xl hover:bg-emerald-50 transition-all flex items-center gap-2">
            <i class="fa-solid fa-location-dot"></i> Change Location / Re-check
        </button>
    </div>

    <!-- City Verification Modal (Prompt on First Visit) -->
    <div id="city-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/80 backdrop-blur-md hidden">
        <div class="bg-white rounded-3xl max-w-md w-full p-8 text-center space-y-4 shadow-2xl relative">
            <div class="w-16 h-16 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-3xl mx-auto"><i class="fa-solid fa-city"></i></div>
            <h3 class="text-xl font-extrabold text-slate-900">Verify Delivery Location</h3>
            <p class="text-xs text-slate-500">Please detect your location or select your city to verify 10-minute delivery availability.</p>
            <div class="space-y-3 pt-2">
                <button onclick="detectUserCity()" class="w-full bg-emerald-600 text-white py-3.5 rounded-2xl font-bold text-sm shadow-md flex items-center justify-center gap-2">
                    <i class="fa-solid fa-location-crosshairs"></i> Detect via GPS 📡
                </button>
                <div class="flex gap-2 pt-2">
                    <select id="manual-city" class="flex-1 bg-slate-100 border rounded-2xl px-3 py-3 text-xs font-bold text-slate-700">
                        <option value="">Select City manually...</option>
                        <option value="Bidasar">Bidasar</option>
                        <option value="Churu">Churu</option>
                        <option value="Jaipur">Jaipur</option>
                        <option value="Udaipur">Udaipur</option>
                        <option value="Delhi">Delhi</option>
                        <option value="Mumbai">Mumbai</option>
                        <option value="Bengaluru">Bengaluru</option>
                    </select>
                    <button onclick="confirmManualCity()" class="bg-slate-900 text-white px-5 py-3 rounded-2xl text-xs font-bold">Verify</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Sticky Navbar -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-100 shadow-xs">
        <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-2 sm:gap-4">
            <div class="flex items-center gap-2 sm:gap-4 shrink-0">
                <a href="/" class="flex items-center gap-2 sm:gap-3">
                    <div class="w-9 h-9 sm:w-11 sm:h-11 rounded-2xl bg-gradient-to-tr from-emerald-600 to-teal-400 flex items-center justify-center text-white shadow-md shadow-emerald-500/20">
                        <i class="fa-solid fa-bolt text-base sm:text-xl"></i>
                    </div>
                    <div class="hidden xs:block">
                        <h1 class="text-sm sm:text-lg font-extrabold tracking-tight text-slate-900">QuickBite <span class="text-emerald-600">Mart</span></h1>
                        <p class="text-[9px] sm:text-[11px] text-emerald-600 font-extrabold flex items-center gap-1"><i class="fa-solid fa-clock"></i> 10 MINS DELIVERY</p>
                    </div>
                </a>

                <button onclick="resetCitySelection()" class="bg-slate-100/90 hover:bg-slate-200/80 text-slate-800 border border-slate-200/80 px-2.5 py-1.5 sm:px-3.5 sm:py-2 rounded-2xl transition-all flex items-center gap-1.5 text-left">
                    <i class="fa-solid fa-location-dot text-emerald-600 text-xs sm:text-sm"></i>
                    <div>
                        <span class="text-[9px] text-slate-400 uppercase font-bold block leading-none hidden sm:block">Delivery To</span>
                        <div class="flex items-center gap-1">
                            <span id="nav-location-text" class="text-xs sm:text-xs font-extrabold max-w-[80px] sm:max-w-[120px] truncate">Bidasar</span>
                            <i class="fa-solid fa-chevron-down text-[10px] text-slate-400"></i>
                        </div>
                    </div>
                </button>
            </div>

            <form method="get" asp-action="Index" class="flex-1 max-w-lg hidden sm:flex items-center relative">
                <input type="text" name="search" value="@searchQuery" placeholder="Search 'milk', 'vegetables', 'snacks'..." 
                       class="w-full bg-slate-100/90 border border-slate-200 rounded-2xl py-3 pl-11 pr-4 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/20" />
                <i class="fa-solid fa-magnifying-glass absolute left-4 text-slate-400 text-sm"></i>
                <input type="hidden" name="category" value="@selectedCategory" />
                <input type="hidden" name="sort" value="@selectedSort" />
            </form>

            <div class="flex items-center gap-2 shrink-0">
                @if (isLoggedIn)
                {
                    <a href="/Home/CustomerDashboard" class="bg-emerald-50 text-emerald-700 px-3 py-2 sm:px-3.5 sm:py-2.5 rounded-2xl font-extrabold text-xs sm:text-sm flex items-center gap-1.5 border border-emerald-200 shadow-xs">
                        <i class="fa-solid fa-user-check text-emerald-600"></i> <span class="max-w-[70px] sm:max-w-[90px] truncate">@userName</span>
                    </a>
                }
                else
                {
                    <button onclick="openAuthModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-2xl font-extrabold text-xs sm:text-sm shadow-md shadow-emerald-600/20 flex items-center gap-1.5">
                        <i class="fa-solid fa-user"></i> <span>Login</span>
                    </button>
                }
                <button onclick="toggleCart()" class="relative bg-slate-900 hover:bg-slate-800 text-white px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-2xl font-bold text-xs sm:text-sm flex items-center gap-1.5 shadow-md">
                    <i class="fa-solid fa-cart-shopping"></i> <span class="hidden sm:inline">Cart</span>
                    <span id="cart-badge" class="w-4 h-4 sm:w-5 sm:h-5 rounded-full bg-emerald-500 text-white text-[10px] sm:text-xs font-extrabold flex items-center justify-center">0</span>
                </button>
            </div>
        </div>
        <div class="px-3 pb-2.5 sm:hidden">
            <form method="get" asp-action="Index" class="flex items-center relative">
                <input type="text" name="search" value="@searchQuery" placeholder="Search 5000+ products..." class="w-full bg-slate-100 border border-slate-200 rounded-xl py-2.5 pl-9 pr-3 text-xs focus:outline-none" />
                <i class="fa-solid fa-magnifying-glass absolute left-3 text-slate-400 text-xs"></i>
                <input type="hidden" name="category" value="@selectedCategory" />
                <input type="hidden" name="sort" value="@selectedSort" />
            </form>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-8 space-y-6 sm:space-y-8">
        
        <!-- Hero Banner -->
        <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl bg-gradient-to-r from-emerald-900 via-emerald-800 to-teal-700 text-white p-6 sm:p-12 shadow-xl">
            <div class="relative z-10 max-w-2xl">
                <span class="bg-emerald-500/30 text-emerald-200 border border-emerald-400/30 text-[10px] sm:text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full inline-block mb-3 sm:mb-4">⚡ Blinkit-Style Quick Commerce</span>
                <h2 class="text-2xl sm:text-5xl font-extrabold tracking-tight mb-2 sm:mb-4">Groceries at your doorstep in 10 minutes</h2>
                <p class="text-emerald-100 text-xs sm:text-base">Fresh vegetables, dairy, snacks & more delivered instantly.</p>
            </div>
        </div>

        <!-- Categories & Sorting -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-2 sm:gap-3 overflow-x-auto pb-2 no-scrollbar">
                @foreach (var cat in categories)
                {
                    var isActive = selectedCategory == cat;
                    <a href="@Url.Action("Index", new { category = cat, search = searchQuery, sort = selectedSort })" class="px-4 py-2 sm:px-5 sm:py-2.5 rounded-xl sm:rounded-2xl text-xs sm:text-sm font-bold whitespace-nowrap transition-all @(isActive ? "bg-emerald-600 text-white shadow-md shadow-emerald-600/30" : "bg-white text-slate-600 border border-slate-200 hover:bg-slate-100")">@cat</a>
                }
            </div>
            <form method="get" asp-action="Index" class="shrink-0">
                <input type="hidden" name="category" value="@selectedCategory" />
                <input type="hidden" name="search" value="@searchQuery" />
                <select name="sort" onchange="this.form.submit()" class="bg-white border border-slate-200 rounded-2xl px-4 py-2.5 text-xs font-bold text-slate-700 shadow-sm focus:outline-none">
                    <option value="">Sort by: Featured</option>
                    <option value="price-low" selected="@(selectedSort == "price-low")">Price: Low to High</option>
                    <option value="price-high" selected="@(selectedSort == "price-high")">Price: High to Low</option>
                    <option value="rating" selected="@(selectedSort == "rating")">Customer Rating</option>
                </select>
            </form>
        </div>

        <!-- Product Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-6">
            @if (Model != null && Model.Any())
            {
                foreach (var p in Model)
                {
                    <div class="blinkit-card rounded-2xl sm:rounded-3xl p-3 sm:p-4 flex flex-col justify-between group">
                        <div>
                            <div class="relative w-full h-32 sm:h-44 rounded-xl sm:rounded-2xl overflow-hidden bg-slate-100 mb-3">
                                <img src="@p.ImageUrl" alt="@p.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                                <div class="absolute bottom-2 left-2 bg-white/90 backdrop-blur-xs px-2 py-0.5 rounded-md text-[10px] sm:text-xs font-extrabold text-slate-800 flex items-center gap-1 shadow-xs">
                                    <i class="fa-solid fa-clock text-emerald-600"></i> 10 MINS
                                </div>
                                @if (p.Stock <= 5 && p.Stock > 0)
                                {
                                    <span class="absolute top-2 left-2 bg-amber-500 text-white px-1.5 py-0.5 rounded-md text-[9px] font-extrabold uppercase">Only @p.Stock left</span>
                                }
                                else if (p.Stock == 0)
                                {
                                    <span class="absolute inset-0 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center text-white font-extrabold text-xs uppercase">Sold Out</span>
                                }
                            </div>
                            <span class="text-[10px] sm:text-xs font-bold text-emerald-600 uppercase">@p.Category</span>
                            <h3 class="font-bold text-slate-900 text-xs sm:text-sm mt-0.5 line-clamp-1">@p.Name</h3>
                            <span class="text-[10px] sm:text-xs text-slate-400 block mt-0.5">@p.Unit</span>
                        </div>
                        <div class="flex items-center justify-between mt-3 pt-3 border-t border-slate-100">
                            <div><span class="text-xs sm:text-sm font-extrabold text-slate-900">₹@p.Price.ToString("0.00")</span></div>
                            @if (p.Stock > 0)
                            {
                                <button type="button" class="add-to-cart-btn bg-emerald-50 hover:bg-emerald-600 text-emerald-700 hover:text-white px-3 py-1.5 sm:px-4 sm:py-2 rounded-xl font-extrabold text-xs transition-all flex items-center gap-1 active:scale-95 border border-emerald-200/60"
                                        data-id="@p.Id" data-name="@p.Name" data-price="@p.Price" data-unit="@p.Unit">
                                    <i class="fa-solid fa-plus text-[10px]"></i> ADD
                                </button>
                            }
                            else
                            {
                                <button disabled class="bg-slate-100 text-slate-400 px-3 py-1.5 rounded-xl font-bold text-xs cursor-not-allowed">Sold Out</button>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </main>

    <!-- Cart Drawer -->
    <div id="cart-drawer" class="fixed inset-0 z-50 overflow-hidden hidden">
        <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm" onclick="toggleCart()"></div>
        <div class="absolute inset-y-0 right-0 max-w-full flex pl-10">
            <div class="w-screen max-w-md bg-white shadow-2xl flex flex-col justify-between">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <h3 class="text-base sm:text-lg font-extrabold text-slate-900 flex items-center gap-2"><i class="fa-solid fa-basket-shopping text-emerald-600"></i> My Cart</h3>
                    <button onclick="toggleCart()" class="w-8 h-8 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div id="cart-items-container" class="flex-1 overflow-y-auto p-5 space-y-3"></div>
                <div class="p-5 border-t border-slate-100 bg-slate-50 space-y-3">
                    <div class="flex gap-2">
                        <input type="text" id="coupon-input" placeholder="Promo code (e.g. QUICK10)" class="flex-1 bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold uppercase focus:outline-none" />
                        <button type="button" onclick="applyCoupon()" class="bg-slate-900 text-white px-4 py-2 rounded-xl text-xs font-bold">Apply</button>
                    </div>
                    <p id="coupon-msg" class="text-[11px] font-semibold hidden"></p>
                    <div class="flex items-center justify-between text-xs text-slate-500"><span>Subtotal</span><span id="cart-subtotal">₹0.00</span></div>
                    <div class="flex items-center justify-between text-xs text-emerald-600 font-bold" id="discount-row" style="display:none;"><span>Discount</span><span id="cart-discount">-₹0.00</span></div>
                    <div class="flex items-center justify-between mb-2"><span class="text-slate-500 font-medium">Total Amount</span><span id="cart-total" class="text-xl font-extrabold text-slate-900">₹0.00</span></div>
                    <button onclick="openCheckoutModal()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white py-3.5 rounded-2xl font-bold shadow-lg shadow-emerald-600/30">Proceed to Checkout 🚀</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Checkout Modal -->
    <div id="checkout-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm hidden">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 md:p-8 shadow-2xl relative max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-xl font-extrabold text-slate-900 flex items-center gap-2"><i class="fa-solid fa-truck-fast text-emerald-600"></i> Delivery & Payment</h3>
                <button onclick="closeCheckoutModal()" class="w-9 h-9 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <form id="checkout-form" onsubmit="submitOrder(event)" class="space-y-4">
                <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Full Name</label><input type="text" id="cust-name" required class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm" /></div>
                <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Phone Number</label><input type="tel" id="cust-phone" required class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm" /></div>
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="block text-xs font-bold uppercase text-slate-500">Delivery Address</label>
                        <button type="button" onclick="fetchGpsLocation()" class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-xl"><i class="fa-solid fa-location-crosshairs"></i> Live GPS</button>
                    </div>
                    <textarea id="cust-address" required rows="2" placeholder="Type address or use GPS" class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm"></textarea>
                    <div class="flex items-center gap-2 mt-2">
                        <select id="save-label" class="bg-slate-100 border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-bold text-slate-700">
                            <option value="Home">Home</option>
                            <option value="Office">Office</option>
                            <option value="Other">Other</option>
                        </select>
                        <button type="button" onclick="saveAddressToProfile()" class="bg-slate-900 text-white px-3.5 py-1.5 rounded-xl text-xs font-bold">Save Address</button>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase text-slate-500 mb-2">Payment Mode</label>
                    <div class="grid grid-cols-3 gap-3">
                        <label class="border border-emerald-500 bg-emerald-50/50 rounded-2xl p-3 flex flex-col items-center justify-center cursor-pointer"><input type="radio" name="pay" checked /><span class="text-xs font-bold mt-1">UPI</span></label>
                        <label class="border border-slate-200 rounded-2xl p-3 flex flex-col items-center justify-center cursor-pointer"><input type="radio" name="pay" /><span class="text-xs font-bold mt-1">Card</span></label>
                        <label class="border border-slate-200 rounded-2xl p-3 flex flex-col items-center justify-center cursor-pointer"><input type="radio" name="pay" /><span class="text-xs font-bold mt-1">COD</span></label>
                    </div>
                </div>
                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white py-4 rounded-2xl font-bold shadow-lg">Confirm & Place Order ✨</button>
            </form>
        </div>
    </div>

    <!-- Auth Modal -->
    <div id="auth-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm hidden">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 md:p-8 shadow-2xl relative">
            <h3 id="auth-title" class="text-xl font-extrabold text-slate-900 mb-6">Customer & Admin Portal Login</h3>
            <form id="login-form" onsubmit="submitLogin(event)" class="space-y-4">
                <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Email, Phone or Admin ID</label><input type="text" id="login-id" required class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm" /></div>
                <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Password</label><input type="password" id="login-pass" required class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm" /></div>
                <button type="submit" class="w-full bg-emerald-600 text-white py-3.5 rounded-2xl font-bold">Login 🚀</button>
                <p class="text-center text-xs text-slate-500 mt-4">No account? <button type="button" onclick="switchAuth('signup')" class="text-emerald-600 font-bold">Sign up here</button></p>
            </form>
            <form id="signup-form" onsubmit="submitSignup(event)" class="space-y-4 hidden">
                <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Full Name</label><input type="text" id="su-name" required class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm" /></div>
                <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Email</label><input type="email" id="su-email" required class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm" /></div>
                <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Phone</label><input type="tel" id="su-phone" required class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm" /></div>
                <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Password</label><input type="password" id="su-pass" required class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm" /></div>
                <button type="submit" class="w-full bg-emerald-600 text-white py-3.5 rounded-2xl font-bold">Register ✨</button>
                <p class="text-center text-xs text-slate-500 mt-4">Have account? <button type="button" onclick="switchAuth('login')" class="text-emerald-600 font-bold">Login</button></p>
            </form>
        </div>
    </div>

    <script>
        window.addEventListener('DOMContentLoaded', async () => {
            setTimeout(() => {
                const splash = document.getElementById('splash-screen');
                splash.style.opacity = '0';
                setTimeout(() => splash.style.visibility = 'hidden', 500);
            }, 800);

            const savedCity = localStorage.getItem('user_city_name');
            if (savedCity) {
                document.getElementById('nav-location-text').innerText = savedCity;
            }

            if (!localStorage.getItem('user_city_verified')) {
                document.getElementById('city-modal').classList.remove('hidden');
            } else {
                // Server check on load against active operating cities database
                await checkServerGeofence(savedCity || "");
            }
        });

        function resetCitySelection() {
            document.getElementById('oos-blocker').classList.add('hidden');
            document.getElementById('city-modal').classList.remove('hidden');
        }

        function detectUserCity() {
            if (!navigator.geolocation) { alert('Geolocation not supported'); return; }
            navigator.geolocation.getCurrentPosition(async pos => {
                try {
                    const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${pos.coords.latitude}&lon=${pos.coords.longitude}`);
                    const data = await res.json();
                    const address = data.address || {};
                    const city = address.city || address.town || address.village || address.state_district || "Detected Location";
                    verifyCityWithServer(city);
                } catch {
                    alert('Could not determine city automatically. Please select manually.');
                }
            }, () => { alert('GPS access denied.'); });
        }

        function confirmManualCity() {
            const val = document.getElementById('manual-city').value;
            if (!val) { alert('Please select a city.'); return; }
            verifyCityWithServer(val);
        }

        async function verifyCityWithServer(cityName) {
            try {
                const res = await fetch('/Home/GetActiveOperatingCities');
                const activeCities = await res.json();

                const lower = cityName.toLowerCase();
                const match = activeCities.some(c => lower.includes(c.toLowerCase()));
                
                localStorage.setItem('user_city_verified', 'true');
                localStorage.setItem('user_city_name', cityName);
                document.getElementById('nav-location-text').innerText = cityName;
                
                document.getElementById('city-modal').classList.add('hidden');

                if (!match) {
                    localStorage.setItem('user_is_out_of_service', 'true');
                    document.getElementById('oos-blocker').classList.remove('hidden');
                } else {
                    localStorage.removeItem('user_is_out_of_service');
                    document.getElementById('oos-blocker').classList.add('hidden');
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function checkServerGeofence(cityName) {
            try {
                const res = await fetch('/Home/GetActiveOperatingCities');
                const activeCities = await res.json();
                const lower = cityName.toLowerCase();
                const match = activeCities.some(c => lower.includes(c.toLowerCase()));

                if (!match) {
                    localStorage.setItem('user_is_out_of_service', 'true');
                    document.getElementById('oos-blocker').classList.remove('hidden');
                } else {
                    localStorage.removeItem('user_is_out_of_service');
                    document.getElementById('oos-blocker').classList.add('hidden');
                }
            } catch (err) {
                console.error(err);
            }
        }

        const isUserLoggedIn = @Json.Serialize(isLoggedIn);
        let cart = JSON.parse(localStorage.getItem('quickbite_cart')) || [];
        let appliedDiscount = 0;
        updateCartUI();

        function toggleCart() { 
            if (localStorage.getItem('user_is_out_of_service') === 'true') {
                document.getElementById('oos-blocker').classList.remove('hidden');
                return;
            }
            document.getElementById('cart-drawer').classList.toggle('hidden'); 
        }

        document.addEventListener('click', e => {
            if (localStorage.getItem('user_is_out_of_service') === 'true') return;
            const btn = e.target.closest('.add-to-cart-btn');
            if (!btn) return;
            const id = parseInt(btn.getAttribute('data-id'), 10);
            const name = btn.getAttribute('data-name');
            const price = parseFloat(btn.getAttribute('data-price'));
            const unit = btn.getAttribute('data-unit');
            const item = cart.find(i => i.id === id);
            if (item) item.qty++; else cart.push({ id, name, price, unit, qty: 1 });
            localStorage.setItem('quickbite_cart', JSON.stringify(cart));
            updateCartUI();
        });

        function removeFromCart(id) {
            cart = cart.filter(i => i.id !== id);
            localStorage.setItem('quickbite_cart', JSON.stringify(cart));
            updateCartUI();
        }

        function updateCartUI() {
            const container = document.getElementById('cart-items-container');
            const badge = document.getElementById('cart-badge');
            const subtotalEl = document.getElementById('cart-subtotal');
            const totalEl = document.getElementById('cart-total');
            if (badge) badge.innerText = cart.reduce((s, i) => s + i.qty, 0);

            if (!container) return;
            if (cart.length === 0) {
                container.innerHTML = `<div class="text-center py-16 text-slate-400"><i class="fa-solid fa-basket-shopping text-5xl mb-3"></i><p>Cart is empty</p></div>`;
                subtotalEl.innerText = '₹0.00'; totalEl.innerText = '₹0.00'; return;
            }

            let html = '', subtotal = 0;
            cart.forEach(i => {
                subtotal += i.price * i.qty;
                html += `<div class="flex items-center justify-between bg-slate-50 p-3 rounded-2xl"><div><h4 class="font-bold text-xs sm:text-sm">${i.name}</h4><span class="text-[11px] text-slate-400">₹${i.price} x ${i.qty}</span></div><div class="flex items-center gap-3"><span class="font-bold text-emerald-600 text-xs sm:text-sm">₹${i.price * i.qty}</span><button onclick="removeFromCart(${i.id})" class="text-rose-500"><i class="fa-solid fa-trash"></i></button></div></div>`;
            });
            container.innerHTML = html;
            subtotalEl.innerText = `₹${subtotal.toFixed(2)}`;
            totalEl.innerText = `₹${Math.max(0, subtotal - appliedDiscount).toFixed(2)}`;
        }

        async function applyCoupon() {
            const code = document.getElementById('coupon-input').value;
            const subtotal = cart.reduce((s, i) => s + (i.price * i.qty), 0);
            const msg = document.getElementById('coupon-msg');
            const res = await fetch(`/Home/ValidateCoupon?code=${code}&cartTotal=${subtotal}`, { method: 'POST' });
            const data = await res.json();
            msg.classList.remove('hidden');
            if (data.success) {
                appliedDiscount = data.discount;
                msg.innerText = data.message; msg.className = 'text-[11px] font-semibold text-emerald-600';
                document.getElementById('discount-row').style.display = 'flex';
                document.getElementById('cart-discount').innerText = `-₹${appliedDiscount.toFixed(2)}`;
                updateCartUI();
            } else {
                appliedDiscount = 0; msg.innerText = data.message; msg.className = 'text-[11px] font-semibold text-rose-600';
            }
        }

        function openCheckoutModal() {
            if (localStorage.getItem('user_is_out_of_service') === 'true') {
                toggleCart();
                document.getElementById('oos-blocker').classList.remove('hidden');
                return;
            }
            if (cart.length === 0) { alert('Cart empty'); return; }
            if (!isUserLoggedIn) { toggleCart(); alert('Login required.'); openAuthModal(); return; }
            toggleCart(); document.getElementById('checkout-modal').classList.remove('hidden');
        }
        function closeCheckoutModal() { document.getElementById('checkout-modal').classList.add('hidden'); }

        async function submitOrder(e) {
            e.preventDefault();
            if (localStorage.getItem('user_is_out_of_service') === 'true') {
                alert('We are not yet operational in your city.');
                return;
            }

            const subtotal = cart.reduce((s, i) => s + (i.price * i.qty), 0);
            const totalAmount = Math.max(0, subtotal - appliedDiscount);
            const orderData = {
                CustomerName: document.getElementById('cust-name').value,
                Phone: document.getElementById('cust-phone').value,
                Address: document.getElementById('cust-address').value,
                TotalAmount: totalAmount,
                DiscountAmount: appliedDiscount,
                CartDataJson: JSON.stringify(cart)
            };

            const res = await fetch('/Home/PlaceOrderAuthenticated', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(orderData) });
            const r = await res.json();
            if (r.success) {
                cart = []; localStorage.removeItem('quickbite_cart');
                window.location.href = '/Home/CustomerDashboard';
            } else { alert(r.message); }
        }

        function openAuthModal() { document.getElementById('auth-modal').classList.remove('hidden'); }
        function switchAuth(m) {
            if (m === 'signup') { document.getElementById('auth-title').innerText = 'Create Account'; document.getElementById('login-form').classList.add('hidden'); document.getElementById('signup-form').classList.remove('hidden'); }
            else { document.getElementById('auth-title').innerText = 'Customer & Admin Portal Login'; document.getElementById('signup-form').classList.add('hidden'); document.getElementById('login-form').classList.remove('hidden'); }
        }
        async function submitLogin(e) {
            e.preventDefault();
            const res = await fetch('/Home/LoginUser', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ identifier: document.getElementById('login-id').value, password: document.getElementById('login-pass').value }) });
            const r = await res.json(); 
            if (r.success) {
                if (r.isAdmin) { window.location.href = '/Admin/Dashboard'; }
                else { window.location.href = '/Home/CustomerDashboard'; }
            } else { alert(r.message); }
        }
        async function submitSignup(e) {
            e.preventDefault();
            const res = await fetch('/Home/Register', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ name: document.getElementById('su-name').value, email: document.getElementById('su-email').value, phone: document.getElementById('su-phone').value, password: document.getElementById('su-pass').value }) });
            const r = await res.json(); if (r.success) window.location.href = '/Home/CustomerDashboard'; else alert(r.message);
        }
        async function fetchGpsLocation() {
            navigator.geolocation.getCurrentPosition(async pos => {
                const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${pos.coords.latitude}&lon=${pos.coords.longitude}`);
                const data = await res.json();
                document.getElementById('cust-address').value = data.display_name || `Lat: ${pos.coords.latitude}, Lng: ${pos.coords.longitude}`;
            });
        }
        async function saveAddressToProfile() {
            const label = document.getElementById('save-label').value;
            const fullAddress = document.getElementById('cust-address').value;
            if (!fullAddress) { alert('Enter or detect address first.'); return; }
            const res = await fetch('/Home/SaveAddress', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ label, fullAddress }) });
            const r = await res.json();
            if (r.success) alert('Address saved successfully to your profile!');
        }
    </script>
</body>
</html>