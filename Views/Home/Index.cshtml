@model List<GroceryStoreApp.Models.Product>
@{
    Layout = null;
    var searchQuery = ViewBag.SearchQuery as string;
    var selectedCategory = ViewBag.SelectedCategory as string;
    var currentSort = ViewBag.CurrentSort as string;
    var categories = ViewBag.Categories as List<string>;
    var isLoggedIn = User.Identity?.IsAuthenticated ?? false;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>QuickBite Mart - 10-Minute Grocery Delivery</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#059669" />
    <style> 
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .glass-card { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.4); }
        .card-3d { transition: all 0.35s cubic-bezier(.03,.98,.52,.99); box-shadow: 0 10px 30px -10px rgba(5, 150, 105, 0.15); }
        .card-3d:hover { transform: translateY(-6px) scale(1.01); box-shadow: 0 20px 40px -15px rgba(5, 150, 105, 0.25); }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased selection:bg-emerald-500 selection:text-white">

    <!-- Top Navbar -->
    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-100 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
            <a href="/" class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-emerald-600 to-teal-400 flex items-center justify-center text-white shadow-lg shadow-emerald-500/30">
                    <i class="fa-solid fa-bolt text-xl"></i>
                </div>
                <div>
                    <h1 class="text-lg font-extrabold tracking-tight text-slate-900">QuickBite <span class="text-emerald-600">Mart</span></h1>
                    <p class="text-[11px] text-emerald-600 font-bold flex items-center gap-1"><i class="fa-solid fa-clock"></i> 10 Mins Delivery</p>
                </div>
            </a>

            <!-- Search Form -->
            <form method="get" asp-action="Index" class="flex-1 max-w-lg hidden md:flex items-center relative">
                <input type="text" name="search" value="@searchQuery" placeholder="Search prefix e.g. 'b' for Bananas, Bread..." 
                       class="w-full bg-slate-100/90 border border-slate-200 rounded-2xl py-3 pl-11 pr-4 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/20" />
                <i class="fa-solid fa-magnifying-glass absolute left-4 text-slate-400 text-sm"></i>
                <input type="hidden" name="category" value="@selectedCategory" />
                <input type="hidden" name="sort" value="@currentSort" />
            </form>

            <div class="flex items-center gap-2 sm:gap-3">
                @if (isLoggedIn)
                {
                    <a href="/Home/CustomerDashboard" class="glass-card hover:bg-emerald-50 text-emerald-700 px-4 py-2.5 rounded-2xl font-extrabold text-xs sm:text-sm flex items-center gap-2 shadow-sm border border-emerald-200">
                        <i class="fa-solid fa-user-check text-emerald-600"></i> Dashboard
                    </a>
                }
                else
                {
                    <button onclick="openUnifiedLoginModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-2xl font-extrabold text-xs sm:text-sm shadow-md shadow-emerald-600/20 transition-all">
                        <i class="fa-solid fa-user mr-1"></i> Login / Admin
                    </button>
                }
                <button onclick="toggleCart()" class="relative bg-slate-900 hover:bg-slate-800 text-white px-4 py-2.5 rounded-2xl font-bold text-xs sm:text-sm flex items-center gap-2 shadow-md transition-all active:scale-95">
                    <i class="fa-solid fa-cart-shopping"></i> Cart
                    <span id="cart-badge" class="w-5 h-5 rounded-full bg-emerald-500 text-white text-xs font-extrabold flex items-center justify-center">0</span>
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Hero Banner with 3D Depth -->
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-emerald-950 via-emerald-900 to-teal-800 text-white p-8 md:p-12 mb-8 shadow-2xl shadow-emerald-950/20">
            <div class="relative z-10 max-w-2xl">
                <span class="bg-emerald-500/30 text-emerald-200 border border-emerald-400/30 text-xs font-bold uppercase tracking-wider px-3.5 py-1 rounded-full inline-block mb-4">⚡ Ultra-Fast Quick Commerce PWA</span>
                <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight mb-4">Fresh Groceries Delivered in 10 Minutes</h2>
                <p class="text-emerald-100 text-base md:text-lg mb-6">Algorithmic prefix search, lightning-fast instant checkout, and live GPS delivery tracking.</p>
            </div>
        </div>

        <!-- Filter & Sorting Bar (Requirement 8) -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-8">
            <div class="flex items-center gap-2 overflow-x-auto pb-2 sm:pb-0 w-full sm:w-auto no-scrollbar">
                @foreach (var cat in categories)
                {
                    var isActive = selectedCategory == cat;
                    <a href="@Url.Action("Index", new { category = cat, search = searchQuery, sort = currentSort })" class="px-5 py-2.5 rounded-2xl text-sm font-bold whitespace-nowrap transition-all @(isActive ? "bg-emerald-600 text-white shadow-lg shadow-emerald-600/30" : "bg-white text-slate-600 border border-slate-200 hover:bg-slate-100")">@cat</a>
                }
            </div>
            
            <form method="get" asp-action="Index" class="flex items-center gap-2 shrink-0 w-full sm:w-auto justify-end">
                <input type="hidden" name="category" value="@selectedCategory" />
                <input type="hidden" name="search" value="@searchQuery" />
                <select name="sort" onchange="this.form.submit()" class="bg-white border border-slate-200 rounded-2xl px-4 py-2.5 text-xs font-bold text-slate-700 shadow-sm focus:outline-none">
                    <option value="default" selected="@(currentSort == "default")">Sort By: Featured</option>
                    <option value="price_low" selected="@(currentSort == "price_low")">Price: Low to High</option>
                    <option value="price_high" selected="@(currentSort == "price_high")">Price: High to Low</option>
                    <option value="rating" selected="@(currentSort == "rating")">Highest Rated ⭐</option>
                    <option value="popularity" selected="@(currentSort == "popularity")">Most Popular 🔥</option>
                </select>
            </form>
        </div>

        <!-- Product Grid with 3D Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            @if (Model != null && Model.Any())
            {
                foreach (var p in Model)
                {
                    <div class="bg-white rounded-3xl border border-slate-100 p-4 card-3d flex flex-col justify-between group">
                        <div>
                            <div class="relative w-full h-48 rounded-2xl overflow-hidden bg-slate-100 mb-4 shadow-inner">
                                <img src="@p.ImageUrl" alt="@p.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                                <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-md px-2.5 py-1 rounded-full text-xs font-bold text-slate-700 flex items-center gap-1 shadow">
                                    <i class="fa-solid fa-star text-amber-400"></i> @p.Rating
                                </div>
                                @if (p.Stock <= 5 && p.Stock > 0)
                                {
                                    <span class="absolute top-3 left-3 bg-amber-500 text-white px-2.5 py-0.5 rounded-lg text-[10px] font-extrabold uppercase shadow">Only @p.Stock left</span>
                                }
                                else if (p.Stock == 0)
                                {
                                    <span class="absolute inset-0 bg-slate-900/70 backdrop-blur-xs flex items-center justify-center text-white font-extrabold text-sm uppercase">Out of Stock</span>
                                }
                                <span class="absolute bottom-3 left-3 bg-black/60 backdrop-blur-md text-white px-2.5 py-0.5 rounded-lg text-xs font-semibold">@p.Unit</span>
                            </div>
                            <span class="text-xs font-bold text-emerald-600 uppercase tracking-wider">@p.Category</span>
                            <h3 class="font-bold text-slate-900 text-base mt-1 line-clamp-1">@p.Name</h3>
                            <p class="text-xs text-slate-400 mt-1 line-clamp-2">@p.Description</p>
                        </div>
                        <div class="flex items-center justify-between mt-4 pt-4 border-t border-slate-100">
                            <div><span class="text-xs text-slate-400 block font-medium">Price</span><span class="text-lg font-extrabold text-slate-900">₹@p.Price.ToString("0.00")</span></div>
                            @if (p.Stock > 0)
                            {
                                <button type="button" class="add-to-cart-btn bg-emerald-50 hover:bg-emerald-600 text-emerald-700 hover:text-white px-4 py-2.5 rounded-xl font-bold text-sm transition-all flex items-center gap-2 active:scale-95 shadow-sm"
                                        data-id="@p.Id" data-name="@p.Name" data-price="@p.Price" data-unit="@p.Unit">
                                    <i class="fa-solid fa-plus"></i> Add
                                </button>
                            }
                            else
                            {
                                <button disabled class="bg-slate-100 text-slate-400 px-4 py-2.5 rounded-xl font-bold text-sm cursor-not-allowed">Sold Out</button>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </main>

    <!-- Slide-over Cart Drawer -->
    <div id="cart-drawer" class="fixed inset-0 z-50 overflow-hidden hidden">
        <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm" onclick="toggleCart()"></div>
        <div class="absolute inset-y-0 right-0 max-w-full flex pl-10">
            <div class="w-screen max-w-md bg-white shadow-2xl flex flex-col justify-between">
                <div class="p-6 border-b border-slate-100 flex items-center justify-between">
                    <h3 class="text-lg font-extrabold text-slate-900 flex items-center gap-2"><i class="fa-solid fa-basket-shopping text-emerald-600"></i> Shopping Basket</h3>
                    <button onclick="toggleCart()" class="w-9 h-9 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div id="cart-items-container" class="flex-1 overflow-y-auto p-6 space-y-4"></div>
                <div class="p-6 border-t border-slate-100 bg-slate-50 space-y-3">
                    <div class="flex gap-2">
                        <input type="text" id="coupon-input" placeholder="Promo code e.g. QUICK10" class="flex-1 bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold uppercase focus:outline-none" />
                        <button type="button" onclick="applyCoupon()" class="bg-slate-900 text-white px-4 py-2 rounded-xl text-xs font-bold">Apply</button>
                    </div>
                    <p id="coupon-msg" class="text-[11px] font-semibold hidden"></p>
                    <div class="flex items-center justify-between text-xs text-slate-500"><span>Subtotal</span><span id="cart-subtotal">₹0.00</span></div>
                    <div class="flex items-center justify-between text-xs text-emerald-600 font-bold" id="discount-row" style="display:none;"><span>Discount</span><span id="cart-discount">-₹0.00</span></div>
                    <div class="flex items-center justify-between mb-2"><span class="text-slate-500 font-medium">Total Amount</span><span id="cart-total" class="text-2xl font-extrabold text-slate-900">₹0.00</span></div>
                    <button onclick="openCheckoutModal()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white py-4 rounded-2xl font-bold shadow-lg shadow-emerald-600/30">Proceed to Checkout 🚀</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Checkout Modal with Live GPS & Saved Addresses (Requirement 3) -->
    <div id="checkout-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm hidden">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 md:p-8 shadow-2xl relative max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-xl font-extrabold text-slate-900 flex items-center gap-2"><i class="fa-solid fa-truck-fast text-emerald-600"></i> Delivery Details</h3>
                <button onclick="closeCheckoutModal()" class="w-9 h-9 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <form id="checkout-form" onsubmit="submitOrder(event)" class="space-y-4">
                <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Full Name</label><input type="text" id="cust-name" required class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm" /></div>
                <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Phone Number</label><input type="tel" id="cust-phone" required class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm" /></div>
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="block text-xs font-bold uppercase text-slate-500">Delivery Address</label>
                        <button type="button" onclick="fetchLiveGps()" class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-xl"><i class="fa-solid fa-location-crosshairs"></i> Use Live GPS</button>
                    </div>
                    <textarea id="cust-address" required rows="3" placeholder="Enter manually or click Use Live GPS" class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm"></textarea>
                    <p id="gps-status" class="text-[11px] text-slate-400 mt-1 hidden"></p>
                </div>
                <!-- Save Address Tag Option -->
                <div class="flex items-center gap-3 bg-slate-50 p-3 rounded-2xl border border-slate-100">
                    <span class="text-xs font-bold text-slate-500 uppercase">Save as:</span>
                    <label class="text-xs font-bold cursor-pointer"><input type="radio" name="addrLabel" value="Home" checked class="accent-emerald-600 mr-1" /> Home</label>
                    <label class="text-xs font-bold cursor-pointer"><input type="radio" name="addrLabel" value="Office" class="accent-emerald-600 mr-1" /> Office</label>
                    <label class="text-xs font-bold cursor-pointer"><input type="radio" name="addrLabel" value="Other" class="accent-emerald-600 mr-1" /> Other</label>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase text-slate-500 mb-2">Payment Mode</label>
                    <div class="grid grid-cols-3 gap-3">
                        <label class="border border-emerald-500 bg-emerald-50/50 rounded-2xl p-3 flex flex-col items-center justify-center cursor-pointer"><input type="radio" name="pay" checked /><span class="text-xs font-bold mt-1">UPI</span></label>
                        <label class="border border-slate-200 rounded-2xl p-3 flex flex-col items-center justify-center cursor-pointer"><input type="radio" name="pay" /><span class="text-xs font-bold mt-1">Card</span></label>
                        <label class="border border-slate-200 rounded-2xl p-3 flex flex-col items-center justify-center cursor-pointer"><input type="radio" name="pay" /><span class="text-xs font-bold mt-1">COD</span></label>
                    </div>
                </div>
                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white py-4 rounded-2xl font-bold shadow-lg shadow-emerald-600/30">Confirm & Place Order ✨</button>
            </form>
        </div>
    </div>

    <!-- Unified Login & Admin Screen (Requirement 9) -->
    <div id="unified-login-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm hidden">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 md:p-8 shadow-2xl relative">
            <div class="flex items-center justify-between mb-6">
                <h3 id="login-modal-title" class="text-xl font-extrabold text-slate-900">QuickBite Access Portal</h3>
                <button onclick="closeUnifiedLoginModal()" class="w-9 h-9 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center"><i class="fa-solid fa-xmark"></i></button>
            </div>
            
            <!-- Login Form -->
            <form id="unified-login-form" onsubmit="submitUnifiedLogin(event)" class="space-y-4">
                <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Email / Phone (or Admin ID)</label><input type="text" id="login-identifier" required placeholder="Enter email, phone or 'admin'" class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm" /></div>
                <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Password</label><input type="password" id="login-password" required placeholder="••••••••" class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm" /></div>
                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white py-3.5 rounded-2xl font-bold shadow-lg shadow-emerald-600/20">Sign In 🚀</button>
                <p class="text-center text-xs text-slate-500 mt-4">Don't have an account? <button type="button" onclick="switchLoginMode('signup')" class="text-emerald-600 font-bold hover:underline">Create Account</button></p>
            </form>

            <!-- Signup Form -->
            <form id="unified-signup-form" onsubmit="submitUnifiedSignup(event)" class="space-y-4 hidden">
                <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Full Name</label><input type="text" id="su-name" required class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm" /></div>
                <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Email Address</label><input type="email" id="su-email" required class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm" /></div>
                <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Phone Number</label><input type="tel" id="su-phone" required class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm" /></div>
                <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Password</label><input type="password" id="su-password" required class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm" /></div>
                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white py-3.5 rounded-2xl font-bold shadow-lg">Register Account ✨</button>
                <p class="text-center text-xs text-slate-500 mt-4">Already registered? <button type="button" onclick="switchLoginMode('login')" class="text-emerald-600 font-bold hover:underline">Sign In</button></p>
            </form>
        </div>
    </div>

    <!-- Client Script Logic -->
    <script>
        const isUserLoggedIn = @Json.Serialize(isLoggedIn);
        let cart = JSON.parse(localStorage.getItem('quickbite_cart')) || [];
        let appliedDiscount = 0;
        updateCartUI();

        if (window.location.search.includes('openAdminLogin=true')) {
            openUnifiedLoginModal();
        }

        function toggleCart() { document.getElementById('cart-drawer').classList.toggle('hidden'); }
        document.addEventListener('click', e => {
            const btn = e.target.closest('.add-to-cart-btn');
            if (!btn) return;
            const id = parseInt(btn.getAttribute('data-id'), 10);
            const name = btn.getAttribute('data-name');
            const price = parseFloat(btn.getAttribute('data-price'));
            const unit = btn.getAttribute('data-unit');
            const item = cart.find(i => i.id === id);
            if (item) item.qty++; else cart.push({ id, name, price, unit, qty: 1 });
            localStorage.setItem('quickbite_cart', JSON.stringify(cart));
            updateCartUI();
        });

        function removeFromCart(id) {
            cart = cart.filter(i => i.id !== id);
            localStorage.setItem('quickbite_cart', JSON.stringify(cart));
            updateCartUI();
        }

        function updateCartUI() {
            const container = document.getElementById('cart-items-container');
            const badge = document.getElementById('cart-badge');
            const subtotalEl = document.getElementById('cart-subtotal');
            const totalEl = document.getElementById('cart-total');
            badge.innerText = cart.reduce((s, i) => s + i.qty, 0);

            if (cart.length === 0) {
                container.innerHTML = `<div class="text-center py-16 text-slate-400"><i class="fa-solid fa-basket-shopping text-5xl mb-3"></i><p>Cart is empty</p></div>`;
                subtotalEl.innerText = '₹0.00'; totalEl.innerText = '₹0.00'; return;
            }

            let html = '', subtotal = 0;
            cart.forEach(i => {
                subtotal += i.price * i.qty;
                html += `<div class="flex items-center justify-between bg-slate-50 p-4 rounded-2xl"><div><h4 class="font-bold text-sm">${i.name}</h4><span class="text-xs text-slate-400">₹${i.price} x ${i.qty}</span></div><div class="flex items-center gap-3"><span class="font-bold text-emerald-600">₹${i.price * i.qty}</span><button onclick="removeFromCart(${i.id})" class="text-rose-500"><i class="fa-solid fa-trash"></i></button></div></div>`;
            });
            container.innerHTML = html;
            subtotalEl.innerText = `₹${subtotal.toFixed(2)}`;
            totalEl.innerText = `₹${Math.max(0, subtotal - appliedDiscount).toFixed(2)}`;
        }

        async function applyCoupon() {
            const code = document.getElementById('coupon-input').value;
            const subtotal = cart.reduce((s, i) => s + (i.price * i.qty), 0);
            const msg = document.getElementById('coupon-msg');
            const res = await fetch(`/Home/ValidateCoupon?code=${code}&cartTotal=${subtotal}`, { method: 'POST' });
            const data = await res.json();
            msg.classList.remove('hidden');
            if (data.success) {
                appliedDiscount = data.discount;
                msg.innerText = data.message; msg.className = 'text-[11px] font-semibold text-emerald-600';
                document.getElementById('discount-row').style.display = 'flex';
                document.getElementById('cart-discount').innerText = `-₹${appliedDiscount.toFixed(2)}`;
                updateCartUI();
            } else {
                appliedDiscount = 0; msg.innerText = data.message; msg.className = 'text-[11px] font-semibold text-rose-600';
            }
        }

        function openCheckoutModal() {
            if (cart.length === 0) { alert('Cart empty'); return; }
            if (!isUserLoggedIn) { toggleCart(); alert('Please login to continue.'); openUnifiedLoginModal(); return; }
            toggleCart(); document.getElementById('checkout-modal').classList.remove('hidden');
        }
        function closeCheckoutModal() { document.getElementById('checkout-modal').classList.add('hidden'); }

        async function fetchLiveGps() {
            const addressField = document.getElementById('cust-address');
            const statusField = document.getElementById('gps-status');
            statusField.classList.remove('hidden'); statusField.innerText = '📡 Detecting GPS location...';
            navigator.geolocation.getCurrentPosition(async pos => {
                try {
                    const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${pos.coords.latitude}&lon=${pos.coords.longitude}`);
                    const data = await res.json();
                    addressField.value = data.display_name || `Lat: ${pos.coords.latitude}, Lng: ${pos.coords.longitude}`;
                    statusField.innerText = '✨ Precise GPS address detected!';
                } catch {
                    addressField.value = `Lat: ${pos.coords.latitude}, Lng: ${pos.coords.longitude}`;
                    statusField.innerText = '✨ Coordinates captured successfully!';
                }
            }, () => { statusField.innerText = '❌ GPS permission denied.'; });
        }

        async function submitOrder(e) {
            e.preventDefault();
            const subtotal = cart.reduce((s, i) => s + (i.price * i.qty), 0);
            const totalAmount = Math.max(0, subtotal - appliedDiscount);
            const addressText = document.getElementById('cust-address').value;
            const addrLabel = document.querySelector('input[name="addrLabel"]:checked').value;

            // Save address asynchronously
            fetch('/Home/SaveAddress', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ label: addrLabel, addressText: addressText }) });

            const orderData = {
                CustomerName: document.getElementById('cust-name').value,
                Phone: document.getElementById('cust-phone').value,
                Address: `[${addrLabel}] ${addressText}`,
                TotalAmount: totalAmount,
                DiscountAmount: appliedDiscount,
                CartDataJson: JSON.stringify(cart)
            };
            const res = await fetch('/Home/PlaceOrderAuthenticated', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(orderData) });
            const r = await res.json();
            if (r.success) {
                cart = []; localStorage.removeItem('quickbite_cart');
                window.location.href = '/Home/CustomerDashboard';
            } else { alert(r.message); }
        }

        function openUnifiedLoginModal() { document.getElementById('unified-login-modal').classList.remove('hidden'); }
        function closeUnifiedLoginModal() { document.getElementById('unified-login-modal').classList.add('hidden'); }
        function switchLoginMode(mode) {
            if (mode === 'signup') { document.getElementById('login-modal-title').innerText = 'Create Account'; document.getElementById('unified-login-form').classList.add('hidden'); document.getElementById('unified-signup-form').classList.remove('hidden'); }
            else { document.getElementById('login-modal-title').innerText = 'QuickBite Access Portal'; document.getElementById('unified-signup-form').classList.add('hidden'); document.getElementById('unified-login-form').classList.remove('hidden'); }
        }
        async function submitUnifiedLogin(e) {
            e.preventDefault();
            const res = await fetch('/Home/UnifiedLogin', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ emailOrPhone: document.getElementById('login-identifier').value, password: document.getElementById('login-password').value }) });
            const r = await res.json();
            if (r.success) { window.location.href = r.redirectUrl; } else { alert(r.message); }
        }
        async function submitUnifiedSignup(e) {
            e.preventDefault();
            const res = await fetch('/Home/Register', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ name: document.getElementById('su-name').value, email: document.getElementById('su-email').value, phone: document.getElementById('su-phone').value, password: document.getElementById('su-password').value }) });
            const r = await res.json(); if (r.success) window.location.href = '/Home/CustomerDashboard'; else alert(r.message);
        }
    </script>
</body>
</html>