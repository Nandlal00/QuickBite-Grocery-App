@{
    Layout = null;
    var user = ViewBag.User as GroceryStoreApp.Models.User;
    var savedAddresses = ViewBag.SavedAddresses as List<GroceryStoreApp.Models.SavedAddress> ?? new();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Customer Dashboard - QuickBite Mart</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style> body { font-family: 'Plus Jakarta Sans', sans-serif; } </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased">
    <header class="bg-white border-b border-slate-100 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <a href="/" class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-emerald-600 to-teal-400 flex items-center justify-center text-white shadow-lg"><i class="fa-solid fa-bolt text-xl"></i></div>
                <div><h1 class="text-lg font-extrabold tracking-tight text-slate-900">QuickBite <span class="text-emerald-600">Mart</span></h1><p class="text-xs text-emerald-600 font-semibold">Customer Dashboard</p></div>
            </a>
            <div class="flex items-center gap-3">
                <a href="/" class="bg-slate-100 text-slate-700 px-4 py-2.5 rounded-xl font-bold text-sm"><i class="fa-solid fa-store mr-2"></i> Store</a>
                <a href="/Home/LogoutUser" class="bg-rose-50 text-rose-600 px-4 py-2.5 rounded-xl font-bold text-sm"><i class="fa-solid fa-right-from-bracket mr-2"></i> Logout</a>
            </div>
        </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
        <div class="bg-gradient-to-r from-emerald-950 to-teal-800 text-white rounded-3xl p-8 shadow-xl flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <span class="bg-emerald-500/30 text-emerald-200 px-3 py-1 rounded-full text-xs font-bold uppercase">Verified Customer</span>
                <h2 class="text-2xl md:text-3xl font-extrabold mt-2">Welcome back, @user?.Name! 👋</h2>
                <p class="text-emerald-100 text-xs mt-1"><i class="fa-solid fa-envelope mr-1"></i> @user?.Email &bull; <i class="fa-solid fa-phone ml-2 mr-1"></i> @user?.Phone</p>
            </div>
        </div>

        <!-- Saved Addresses Section (Requirement 3) -->
        <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
            <h3 class="text-base font-extrabold text-slate-900 mb-4 flex items-center gap-2"><i class="fa-solid fa-address-book text-emerald-600"></i> Saved Delivery Addresses</h3>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                @if (savedAddresses.Any())
                {
                    foreach (var addr in savedAddresses)
                    {
                        <div class="bg-slate-50 border border-slate-100 p-4 rounded-2xl">
                            <span class="bg-emerald-100 text-emerald-800 text-[10px] font-extrabold uppercase px-2.5 py-0.5 rounded-lg">@addr.Label</span>
                            <p class="text-xs text-slate-600 mt-2 line-clamp-2">@addr.AddressText</p>
                        </div>
                    }
                }
                else
                {
                    <p class="text-xs text-slate-400">No saved addresses yet. Your checkout addresses will appear here automatically.</p>
                }
            </div>
        </div>

        <div class="flex items-center justify-between">
            <h3 class="text-xl font-extrabold text-slate-900 flex items-center gap-2"><i class="fa-solid fa-timeline text-emerald-600"></i> Live Order Tracking</h3>
            <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 border border-emerald-200 px-3 py-1 rounded-full animate-pulse">● Live Polling Active (5s)</span>
        </div>

        <div id="live-orders-container" class="space-y-6">
            <div class="bg-white rounded-3xl border border-slate-200 p-12 text-center text-slate-400">Loading live orders...</div>
        </div>
    </main>

    <script>
        async function fetchLiveOrders() {
            try {
                const res = await fetch('/Home/GetCustomerOrdersJson');
                const data = await res.json();
                const container = document.getElementById('live-orders-container');

                if (!data.success || data.orders.length === 0) {
                    container.innerHTML = `
                        <div class="bg-white rounded-3xl border border-slate-200 p-12 text-center text-slate-400">
                            <i class="fa-solid fa-basket-shopping text-5xl mb-3"></i>
                            <p class="font-semibold text-base">You haven't placed any orders yet.</p>
                            <a href="/" class="inline-block mt-4 bg-emerald-600 text-white px-6 py-3 rounded-2xl font-bold text-sm shadow-md">Start Shopping 🚀</a>
                        </div>
                    `;
                    return;
                }

                let html = '';
                data.orders.forEach(o => {
                    let step1 = 'bg-emerald-600 text-white', step2 = 'bg-slate-200 text-slate-500', step3 = 'bg-slate-200 text-slate-500';
                    if (o.status === 'Out for Delivery') { step2 = 'bg-amber-500 text-white shadow-md'; }
                    if (o.status === 'Completed') { step2 = 'bg-emerald-600 text-white'; step3 = 'bg-emerald-600 text-white shadow-md'; }
                    if (o.status === 'Cancelled') { step1 = step2 = step3 = 'bg-rose-100 text-rose-600'; }

                    html += `
                        <div class="bg-white border border-slate-200/80 rounded-3xl p-6 shadow-sm space-y-4">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 pb-4 gap-2">
                                <div><span class="text-xs font-bold text-slate-400 uppercase">Order Reference</span><h4 class="font-extrabold text-slate-900 text-lg">${o.customerName}</h4></div>
                                <span class="px-4 py-1.5 rounded-full text-xs font-bold border bg-emerald-50 text-emerald-700 border-emerald-200"><i class="fa-solid fa-circle-dot mr-1"></i> ${o.status}</span>
                            </div>
                            <!-- Visual Timeline -->
                            <div class="grid grid-cols-3 gap-2 text-center text-xs font-bold">
                                <div class="py-2.5 rounded-2xl ${step1}">1. Order Packed</div>
                                <div class="py-2.5 rounded-2xl ${step2}">2. Out for Delivery</div>
                                <div class="py-2.5 rounded-2xl ${step3}">3. Delivered</div>
                            </div>
                            <div><p class="text-xs text-slate-500 font-semibold"><i class="fa-solid fa-location-dot text-emerald-600 mr-1"></i> ${o.address}</p></div>
                            <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                                <span class="text-sm font-semibold text-slate-500">Total Amount</span>
                                <div class="flex items-center gap-4">
                                    <span class="text-lg font-extrabold text-emerald-600">₹${o.totalAmount.toFixed(2)}</span>
                                    <button onclick='reorderCart(${o.cartData})' class="bg-emerald-50 hover:bg-emerald-100 text-emerald-700 px-4 py-2 rounded-xl font-bold text-xs border border-emerald-200 transition-all">Reorder ⚡</button>
                                </div>
                            </div>
                        </div>
                    `;
                });
                container.innerHTML = html;
            } catch (err) { console.error(err); }
        }

        function reorderCart(cartJson) {
            localStorage.setItem('quickbite_cart', JSON.stringify(cartJson));
            alert('Cart refilled with previous items! Redirecting to storefront.');
            window.location.href = '/';
        }

        fetchLiveOrders();
        setInterval(fetchLiveOrders, 5000);
    </script>
</body>
</html>