@{
    Layout = null;
    var user = ViewBag.User as GroceryStoreApp.Models.User;
    var addresses = ViewBag.Addresses as List<GroceryStoreApp.Models.SavedAddress> ?? new();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Customer Dashboard - QuickBite Mart</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style> body { font-family: 'Plus Jakarta Sans', sans-serif; } </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased">
    <header class="bg-white border-b border-slate-100 shadow-sm sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <a href="/" class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-emerald-600 to-teal-400 flex items-center justify-center text-white shadow-md shadow-emerald-500/20">
                    <i class="fa-solid fa-bolt text-xl"></i>
                </div>
                <div>
                    <h1 class="text-lg font-extrabold tracking-tight text-slate-900">QuickBite <span class="text-emerald-600">Mart</span></h1>
                    <p class="text-[11px] text-emerald-600 font-extrabold uppercase">Customer Portal</p>
                </div>
            </a>
            <div class="flex items-center gap-3">
                <a href="/" class="bg-emerald-50 text-emerald-700 px-4 py-2.5 rounded-xl font-bold text-sm">Store Catalog ⚡</a>
                <a href="/Home/LogoutUser" class="bg-rose-50 text-rose-600 px-4 py-2.5 rounded-xl font-bold text-sm">Logout</a>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
        <!-- Profile Banner -->
        <div class="bg-gradient-to-r from-emerald-900 to-teal-800 text-white p-8 rounded-3xl shadow-xl flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
            <div>
                <span class="bg-emerald-500/30 text-emerald-200 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full inline-block mb-2">Verified Customer</span>
                <h2 class="text-3xl font-extrabold">Welcome back, @user?.Name! 👋</h2>
                <p class="text-emerald-100 text-sm mt-1"><i class="fa-solid fa-envelope mr-1"></i> @user?.Email &bull; <i class="fa-solid fa-phone ml-2 mr-1"></i> @user?.Phone</p>
            </div>
            <div class="bg-white/10 backdrop-blur-md p-4 rounded-2xl border border-white/10 text-center">
                <span class="block text-xs uppercase tracking-wider text-emerald-200 font-bold">Delivery Speed</span>
                <span class="text-2xl font-extrabold">10 Mins ⚡</span>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Left: Live Orders & History -->
            <div class="lg:col-span-2 space-y-6">
                <div class="bg-white rounded-3xl border border-slate-100 p-6 shadow-sm">
                    <h3 class="text-xl font-extrabold text-slate-900 mb-6 flex items-center gap-2"><i class="fa-solid fa-clock-rotate-left text-emerald-600"></i> Live Order Tracking & History</h3>
                    <div id="orders-container" class="space-y-4">
                        <p class="text-slate-400 text-sm">Loading live orders...</p>
                    </div>
                </div>
            </div>

            <!-- Right: Saved Addresses -->
            <div class="space-y-6">
                <div class="bg-white rounded-3xl border border-slate-100 p-6 shadow-sm">
                    <h3 class="text-lg font-extrabold text-slate-900 mb-4 flex items-center gap-2"><i class="fa-solid fa-location-dot text-emerald-600"></i> Saved Address Book</h3>
                    <div class="space-y-3">
                        @if (addresses.Any())
                        {
                            foreach (var addr in addresses)
                            {
                                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
                                    <span class="bg-emerald-100 text-emerald-800 text-[10px] font-extrabold px-2.5 py-0.5 rounded-full uppercase">@addr.Label</span>
                                    <p class="text-xs text-slate-600 mt-2 font-medium">@addr.FullAddress</p>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-xs text-slate-400">No saved addresses yet. Save an address during checkout!</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        async function fetchLiveOrders() {
            try {
                const res = await fetch('/Home/GetCustomerOrdersJson');
                const data = await res.json();
                const container = document.getElementById('orders-container');
                if (!data.success || data.orders.length === 0) {
                    container.innerHTML = `<p class="text-slate-400 text-sm py-4">No orders placed yet. Start shopping!</p>`;
                    return;
                }

                let html = '';
                data.orders.forEach(o => {
                    let statusColor = 'bg-amber-100 text-amber-800';
                    if (o.status === 'Out for Delivery') statusColor = 'bg-blue-100 text-blue-800';
                    if (o.status === 'Completed') statusColor = 'bg-emerald-100 text-emerald-800';
                    if (o.status === 'Cancelled') statusColor = 'bg-rose-100 text-rose-800';

                    let cancelBtn = '';
                    if (o.status === 'Processing') {
                        cancelBtn = `<button onclick="cancelOrder(${o.id})" class="bg-rose-50 hover:bg-rose-100 text-rose-600 px-4 py-2 rounded-xl font-bold text-xs border border-rose-200">Cancel Order ❌</button>`;
                    }

                    html += `
                        <div class="border border-slate-100 rounded-2xl p-5 bg-slate-50/50 space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="font-extrabold text-sm text-slate-900">Order #${o.id}</span>
                                <span class="px-3 py-1 rounded-full text-xs font-extrabold ${statusColor}">${o.status}</span>
                            </div>
                            <p class="text-xs text-slate-500"><strong>Address:</strong> ${o.address}</p>
                            <div class="flex items-center justify-between pt-2 border-t border-slate-200/60">
                                <span class="font-extrabold text-emerald-600 text-sm">₹${o.totalAmount.toFixed(2)}</span>
                                <div class="flex items-center gap-2 flex-wrap">
                                    ${cancelBtn}
                                    <a href="/Home/DownloadInvoice?id=${o.id}" target="_blank" class="bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 rounded-xl font-bold text-xs flex items-center gap-1.5 shadow-sm">
                                        <i class="fa-solid fa-file-pdf text-emerald-400"></i> Invoice 📄
                                    </a>
                                    <button onclick='reorderCart(${o.cartData})' class="bg-emerald-50 hover:bg-emerald-100 text-emerald-700 px-4 py-2 rounded-xl font-bold text-xs border border-emerald-200">Reorder ⚡</button>
                                </div>
                            </div>
                        </div>`;
                });
                container.innerHTML = html;
            } catch (err) {
                console.error(err);
            }
        }

        async function cancelOrder(id) {
            if (!confirm('Are you sure you want to cancel this order?')) return;
            const res = await fetch(`/Home/CancelOrder?id=${id}`, { method: 'POST' });
            const r = await res.json();
            if (r.success) {
                alert(r.message);
                fetchLiveOrders();
            } else {
                alert(r.message);
            }
        }

        function reorderCart(cartJson) {
            localStorage.setItem('quickbite_cart', JSON.stringify(cartJson));
            alert('Cart refilled!'); window.location.href = '/';
        }

        fetchLiveOrders();
        setInterval(fetchLiveOrders, 3000);
    </script>
</body>
</html>