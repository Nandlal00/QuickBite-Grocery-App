@{
    Layout = null;
    ViewData["Title"] = "Admin Login - QuickBite Mart";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style> body { font-family: 'Plus Jakarta Sans', sans-serif; } </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex items-center justify-center p-4">

    <div class="bg-white text-slate-800 rounded-3xl max-w-md w-full p-8 shadow-2xl">
        <div class="text-center mb-8">
            <div class="w-16 h-16 bg-emerald-600 rounded-2xl flex items-center justify-center text-white text-2xl mx-auto mb-4 shadow-lg shadow-emerald-600/30">
                <i class="fa-solid fa-lock"></i>
            </div>
            <h2 class="text-2xl font-extrabold text-slate-900">Admin Portal</h2>
            <p class="text-xs text-slate-400 mt-1">Sign in to manage QuickBite Mart store</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="bg-rose-50 border border-rose-200 text-rose-600 text-xs font-bold p-3 rounded-xl mb-4 text-center">
                @ViewBag.Error
            </div>
        }

        <form method="post" asp-action="Login" class="space-y-4">
            <div>
                <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Username</label>
                <input type="text" name="username" required placeholder="admin" 
                       class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500" />
            </div>
            <div>
                <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Password</label>
                <input type="password" name="password" required placeholder="grocery123" 
                       class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500" />
            </div>
            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white py-4 rounded-2xl font-bold shadow-lg shadow-emerald-600/30 transition-all mt-2">
                Login to Dashboard 🚀
            </button>
        </form>
        
        <div class="text-center mt-6">
            <a href="/" class="text-xs font-bold text-emerald-600 hover:underline"><i class="fa-solid fa-arrow-left"></i> Back to Storefront</a>
        </div>
    </div>
</body>
</html>