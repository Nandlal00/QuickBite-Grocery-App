@{
    Layout = null;
    var orders = ViewBag.Orders as List<GroceryStoreApp.Models.OrderViewModel> ?? new();
    var products = ViewBag.Products as List<GroceryStoreApp.Models.Product> ?? new();
    var coupons = ViewBag.Coupons as List<GroceryStoreApp.Models.Coupon> ?? new();
    var cities = ViewBag.Cities as List<GroceryStoreApp.Models.OperatingCity> ?? new();
    int totalVisitors = ViewBag.TotalVisitors ?? 0;
    int totalCustomers = ViewBag.TotalCustomers ?? 0;
    decimal totalRevenue = ViewBag.TotalRevenue ?? 0m;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard - QuickBite Mart</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style> body { font-family: 'Plus Jakarta Sans', sans-serif; } </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased">
    <header class="bg-white border-b border-slate-100 shadow-sm sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <h1 class="text-lg font-extrabold text-slate-900"><i class="fa-solid fa-shield-halved text-emerald-600 mr-2"></i> Admin Analytics & Control Center</h1>
            <div class="flex items-center gap-3">
                <a href="/" class="bg-slate-100 text-slate-700 px-4 py-2.5 rounded-xl font-bold text-sm">View Store</a>
                <a href="/Admin/Logout" class="bg-rose-50 text-rose-600 px-4 py-2.5 rounded-xl font-bold text-sm">Logout</a>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
        <!-- Analytics Overview Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-6">
            <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm"><span class="text-xs text-slate-400 font-bold">TOTAL REVENUE</span><h3 class="text-2xl font-extrabold text-emerald-600">₹@totalRevenue.ToString("0.00")</h3></div>
            <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm"><span class="text-xs text-slate-400 font-bold">ORDERS RECEIVED</span><h3 class="text-2xl font-extrabold">@orders.Count</h3></div>
            <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm"><span class="text-xs text-slate-400 font-bold">REGISTERED ACCOUNTS</span><h3 class="text-2xl font-extrabold">@totalCustomers</h3></div>
            <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm"><span class="text-xs text-slate-400 font-bold">WEBSITE VISITORS</span><h3 class="text-2xl font-extrabold text-sky-600">@totalVisitors</h3></div>
        </div>

        <!-- Operating Cities Management Section -->
        <div class="bg-white rounded-3xl border border-slate-100 p-6 shadow-sm space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h3 class="text-lg font-extrabold text-slate-900"><i class="fa-solid fa-city text-emerald-600 mr-2"></i> Operating Cities Geofence</h3>
                    <p class="text-xs text-slate-400 mt-1">Select and toggle active dark store cities. Unselected cities will see "We are coming soon here!".</p>
                </div>
                <form asp-action="AddCity" method="post" class="flex gap-2">
                    <input type="text" name="cityName" required placeholder="New City Name..." class="bg-slate-100 border border-slate-200 rounded-2xl py-2 px-4 text-xs font-bold focus:outline-none" />
                    <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-2xl text-xs font-bold shadow-md">Add City +</button>
                </form>
            </div>
            
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
                @foreach (var city in cities)
                {
                    <div class="border rounded-2xl p-3 flex flex-col justify-between transition-all @(city.IsActive ? "bg-emerald-50/60 border-emerald-300" : "bg-slate-50 border-slate-200 opacity-60")">
                        <div class="flex items-center justify-between mb-2">
                            <span class="font-extrabold text-xs sm:text-sm text-slate-900">@city.Name</span>
                            <form asp-action="DeleteCity" method="post">
                                <input type="hidden" name="id" value="@city.Id" />
                                <button type="submit" class="text-rose-500 text-[10px]"><i class="fa-solid fa-xmark"></i></button>
                            </form>
                        </div>
                        <form asp-action="ToggleCityStatus" method="post">
                            <input type="hidden" name="id" value="@city.Id" />
                            <button type="submit" class="w-full py-1.5 rounded-xl text-[10px] font-bold @(city.IsActive ? "bg-emerald-600 text-white" : "bg-slate-300 text-slate-700")">
                                @(city.IsActive ? "Active Store" : "Inactive")
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>

        <!-- Orders Management -->
        <div class="bg-white rounded-3xl border border-slate-100 p-6 shadow-sm">
            <h3 class="text-xl font-extrabold text-slate-900 mb-6"><i class="fa-solid fa-clock-rotate-left text-emerald-600 mr-2"></i> Live Orders & Status Management</h3>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead><tr class="border-b text-xs text-slate-400 uppercase"><th>Order & Customer</th><th>Phone & Address</th><th>Total</th><th>Status Control</th></tr></thead>
                    <tbody class="divide-y">
                        @foreach (var o in orders)
                        {
                            <tr>
                                <td class="py-4 font-bold">@o.CustomerName</td>
                                <td class="py-4"><span class="block">@o.Phone</span><span class="text-xs text-slate-400">@o.Address</span></td>
                                <td class="py-4 font-extrabold text-emerald-600">₹@o.TotalAmount.ToString("0.00")</td>
                                <td class="py-4">
                                    <form asp-action="UpdateOrderStatus" method="post">
                                        <input type="hidden" name="id" value="@o.Id" />
                                        <select name="status" onchange="this.form.submit()" class="bg-slate-100 border rounded-xl px-3 py-1 text-xs font-bold">
                                            <option value="Processing" selected="@(o.Status == "Processing")">Processing</option>
                                            <option value="Out for Delivery" selected="@(o.Status == "Out for Delivery")">Out for Delivery</option>
                                            <option value="Completed" selected="@(o.Status == "Completed")">Completed</option>
                                            <option value="Cancelled" selected="@(o.Status == "Cancelled")">Cancelled</option>
                                        </select>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Coupon Manager & Product Manager -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Coupons -->
            <div class="bg-white rounded-3xl border border-slate-100 p-6 shadow-sm space-y-4">
                <h3 class="text-lg font-extrabold">Promo Coupons Management</h3>
                <form asp-action="AddCoupon" method="post" class="space-y-3">
                    <input type="text" name="Code" required placeholder="Code (e.g. QUICK10)" class="w-full bg-slate-100 rounded-2xl py-2.5 px-4 text-sm uppercase" />
                    <div class="grid grid-cols-2 gap-2">
                        <input type="number" name="DiscountPercent" required placeholder="Discount %" class="bg-slate-100 rounded-2xl py-2.5 px-3 text-sm" />
                        <input type="number" name="MinOrderAmount" required placeholder="Min Order ₹" class="bg-slate-100 rounded-2xl py-2.5 px-3 text-sm" />
                    </div>
                    <button type="submit" class="w-full bg-slate-900 text-white py-3 rounded-2xl font-bold">Create Coupon</button>
                </form>
                <div class="space-y-2 mt-4 max-h-[180px] overflow-y-auto">
                    @foreach (var c in coupons)
                    {
                        <div class="flex items-center justify-between bg-slate-50 p-3 rounded-xl text-xs font-bold">
                            <span>@c.Code (@c.DiscountPercent% off, min ₹@c.MinOrderAmount)</span>
                            <form asp-action="DeleteCoupon" method="post"><input type="hidden" name="id" value="@c.Id" /><button class="text-rose-500"><i class="fa-solid fa-trash"></i></button></form>
                        </div>
                    }
                </div>
            </div>

            <!-- Add Product -->
            <div class="bg-white rounded-3xl border border-slate-100 p-6 shadow-sm">
                <h3 class="text-lg font-extrabold mb-4">Add Product (Stock, Description & Image)</h3>
                <form asp-action="AddProduct" method="post" enctype="multipart/form-data" class="space-y-3">
                    <input type="text" name="Name" required placeholder="Product Name" class="w-full bg-slate-100 rounded-2xl py-2.5 px-4 text-sm" />
                    <div class="grid grid-cols-3 gap-2">
                        <input type="text" name="Category" required placeholder="Category" class="bg-slate-100 rounded-2xl py-2.5 px-3 text-sm" />
                        <input type="number" step="0.01" name="Price" required placeholder="Price" class="bg-slate-100 rounded-2xl py-2.5 px-3 text-sm" />
                        <input type="number" name="Stock" required placeholder="Stock Qty" class="bg-slate-100 rounded-2xl py-2.5 px-3 text-sm" />
                    </div>
                    <input type="text" name="imageUrlInput" placeholder="Online Image URL (Optional)" class="w-full bg-slate-100 rounded-2xl py-2.5 px-4 text-sm" />
                    <input type="file" name="imageFile" class="w-full text-xs text-slate-500" />
                    <textarea name="Description" rows="2" placeholder="Product Description..." class="w-full bg-slate-100 rounded-2xl py-2 px-4 text-sm"></textarea>
                    <button type="submit" class="w-full bg-emerald-600 text-white py-3 rounded-2xl font-bold">Save Product</button>
                </form>
            </div>
        </div>
    </main>
</body>
</html>