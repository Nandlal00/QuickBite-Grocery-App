@{
    Layout = null;
    var orders = ViewBag.Orders as List<GroceryStoreApp.Models.OrderViewModel> ?? new();
    var products = ViewBag.Products as List<GroceryStoreApp.Models.Product> ?? new();
    var coupons = ViewBag.Coupons as List<GroceryStoreApp.Models.Coupon> ?? new();
    decimal totalRevenue = ViewBag.TotalRevenue;
    int completedOrders = ViewBag.CompletedOrders;
    int activeOrdersCount = ViewBag.ActiveOrdersCount;
    string topProduct = ViewBag.TopSellingProduct;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard - QuickBite Mart</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style> body { font-family: 'Plus Jakarta Sans', sans-serif; } </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased">

    <!-- Header Navbar -->
    <header class="bg-white border-b border-slate-100 shadow-sm sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-emerald-600 to-teal-400 flex items-center justify-center text-white shadow-lg shadow-emerald-500/30">
                    <i class="fa-solid fa-shield-halved text-xl"></i>
                </div>
                <div>
                    <h1 class="text-lg font-extrabold tracking-tight text-slate-900">Admin Control Center</h1>
                    <p class="text-xs text-emerald-600 font-semibold">QuickBite Mart Management</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <a href="/" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 py-2.5 rounded-xl font-bold text-sm transition-all"><i class="fa-solid fa-store mr-2"></i> View Store</a>
                <a href="/Admin/Logout" class="bg-rose-50 hover:bg-rose-100 text-rose-600 px-4 py-2.5 rounded-xl font-bold text-sm transition-all"><i class="fa-solid fa-right-from-bracket mr-2"></i> Logout</a>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
        
        <!-- Business Analytics Cards (Requirement 13) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl font-bold"><i class="fa-solid fa-indian-rupee-sign"></i></div>
                <div><span class="text-xs text-slate-400 font-bold uppercase">Total Revenue</span><h3 class="text-xl font-extrabold text-slate-900">₹@totalRevenue.ToString("0.00")</h3></div>
            </div>
            <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-2xl font-bold"><i class="fa-solid fa-box-open"></i></div>
                <div><span class="text-xs text-slate-400 font-bold uppercase">Active Orders</span><h3 class="text-xl font-extrabold text-slate-900">@activeOrdersCount</h3></div>
            </div>
            <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-sky-50 text-sky-600 flex items-center justify-center text-2xl font-bold"><i class="fa-solid fa-circle-check"></i></div>
                <div><span class="text-xs text-slate-400 font-bold uppercase">Completed Deliveries</span><h3 class="text-xl font-extrabold text-slate-900">@completedOrders</h3></div>
            </div>
            <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-2xl font-bold"><i class="fa-solid fa-fire"></i></div>
                <div><span class="text-xs text-slate-400 font-bold uppercase">Top Selling Item</span><h3 class="text-xs font-extrabold text-slate-900 truncate max-w-[120px]">@topProduct</h3></div>
            </div>
        </div>

        <!-- Orders Management Table with Live Status Update Dropdowns -->
        <div class="bg-white rounded-3xl border border-slate-100 p-6 sm:p-8 shadow-sm">
            <h3 class="text-xl font-extrabold text-slate-900 mb-6 flex items-center gap-2"><i class="fa-solid fa-clock-rotate-left text-emerald-600"></i> Customer Orders & Live Status Management</h3>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-100 text-xs font-bold uppercase text-slate-400">
                            <th class="pb-4">Order Reference & Customer</th>
                            <th class="pb-4">Contact & Address</th>
                            <th class="pb-4">Total Amount</th>
                            <th class="pb-4">Live Status Control</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm">
                        @if (orders.Any())
                        {
                            foreach (var order in orders)
                            {
                                <tr class="hover:bg-slate-50/50">
                                    <td class="py-4 pr-4"><span class="font-extrabold text-slate-900 block">@order.CustomerName</span></td>
                                    <td class="py-4 pr-4">
                                        <span class="font-semibold text-slate-700 block"><i class="fa-solid fa-phone text-xs text-emerald-600 mr-1"></i> @order.Phone</span>
                                        <span class="text-xs text-slate-400 block mt-0.5"><i class="fa-solid fa-location-dot mr-1"></i> @order.Address</span>
                                    </td>
                                    <td class="py-4 pr-4 font-extrabold text-emerald-600">₹@order.TotalAmount.ToString("0.00")</td>
                                    <td class="py-4">
                                        <form asp-action="UpdateOrderStatus" method="post" class="flex items-center gap-2">
                                            <input type="hidden" name="id" value="@order.Id" />
                                            <select name="status" onchange="this.form.submit()" class="bg-slate-100 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-700 focus:ring-2 focus:ring-emerald-500/20">
                                                <option value="Processing" selected="@(order.Status == "Processing")">Processing</option>
                                                <option value="Out for Delivery" selected="@(order.Status == "Out for Delivery")">Out for Delivery</option>
                                                <option value="Completed" selected="@(order.Status == "Completed")">Completed</option>
                                                <option value="Cancelled" selected="@(order.Status == "Cancelled")">Cancelled</option>
                                            </select>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="py-12 text-center text-slate-400">No customer orders yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Add Coupon & Add Product Forms -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="bg-white rounded-3xl border border-slate-100 p-6 sm:p-8 shadow-sm">
                <h3 class="text-lg font-extrabold text-slate-900 mb-6 flex items-center gap-2"><i class="fa-solid fa-ticket text-emerald-600"></i> Create Promo Coupon</h3>
                <form asp-action="AddCoupon" method="post" class="space-y-4">
                    <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Coupon Code</label><input type="text" name="Code" required placeholder="e.g. QUICK10" class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm uppercase" /></div>
                    <div class="grid grid-cols-2 gap-3">
                        <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Discount (%)</label><input type="number" name="DiscountPercent" required placeholder="10" class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm" /></div>
                        <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Min Order (₹)</label><input type="number" name="MinOrderAmount" required placeholder="199" class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm" /></div>
                    </div>
                    <button type="submit" class="w-full bg-slate-900 hover:bg-slate-800 text-white py-3.5 rounded-2xl font-bold shadow-md transition-all">Save Coupon Code 🎟️</button>
                </form>
            </div>

            <div class="bg-white rounded-3xl border border-slate-100 p-6 sm:p-8 shadow-sm">
                <h3 class="text-lg font-extrabold text-slate-900 mb-6 flex items-center gap-2"><i class="fa-solid fa-plus text-emerald-600"></i> Add Product & Stock (Requirement 11)</h3>
                <form asp-action="AddProduct" method="post" enctype="multipart/form-data" class="space-y-4">
                    <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Product Name</label><input type="text" name="Name" required placeholder="e.g. Fresh Tomatoes" class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-4 text-sm" /></div>
                    <div class="grid grid-cols-3 gap-2">
                        <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Category</label><input type="text" name="Category" required placeholder="Vegetables" class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-3 text-sm" /></div>
                        <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Price (₹)</label><input type="number" step="0.01" name="Price" required placeholder="40.00" class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-3 text-sm" /></div>
                        <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Stock</label><input type="number" name="Stock" required placeholder="50" class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3 px-3 text-sm" /></div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Upload Desktop File</label><input type="file" name="imageFile" accept="image/*" class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-2 px-3 text-xs text-slate-600" /></div>
                        <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">OR External URL</label><input type="url" name="externalImageUrl" placeholder="https://..." class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-2 px-3 text-xs" /></div>
                    </div>
                    <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white py-3.5 rounded-2xl font-bold shadow-lg shadow-emerald-600/30 transition-all">Add Product 🚀</button>
                </form>
            </div>
        </div>

        <!-- Inventory & Low-Stock Alerts -->
        <div class="bg-white rounded-3xl border border-slate-100 p-6 sm:p-8 shadow-sm">
            <h3 class="text-lg font-extrabold text-slate-900 mb-6 flex items-center gap-2"><i class="fa-solid fa-boxes-stacked text-emerald-600"></i> Store Inventory & Stock Alerts</h3>
            <div class="overflow-x-auto max-h-[400px] overflow-y-auto">
                <table class="w-full text-left border-collapse">
                    <thead><tr class="border-b border-slate-100 text-xs font-bold uppercase text-slate-400"><th class="pb-3">Product</th><th class="pb-3">Category</th><th class="pb-3">Price</th><th class="pb-3">Stock Status</th><th class="pb-3 text-right">Action</th></tr></thead>
                    <tbody class="divide-y divide-slate-100 text-sm">
                        @foreach (var prod in products)
                        {
                            <tr class="hover:bg-slate-50/50">
                                <td class="py-3 pr-3 flex items-center gap-3">
                                    <img src="@prod.ImageUrl" class="w-10 h-10 rounded-xl object-cover bg-slate-100" />
                                    <span class="font-bold text-slate-900">@prod.Name</span>
                                </td>
                                <td class="py-3 font-semibold text-slate-600">@prod.Category</td>
                                <td class="py-3 font-extrabold text-emerald-600">₹@prod.Price.ToString("0.00")</td>
                                <td class="py-3">
                                    @if (prod.Stock <= 5)
                                    {
                                        <span class="bg-rose-50 text-rose-600 border border-rose-200 px-3 py-1 rounded-full text-xs font-bold">⚠️ Low Stock (@prod.Stock)</span>
                                    }
                                    else
                                    {
                                        <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 px-3 py-1 rounded-full text-xs font-bold">In Stock (@prod.Stock)</span>
                                    }
                                </td>
                                <td class="py-3 text-right">
                                    <form asp-action="DeleteProduct" method="post" onsubmit="return confirm('Delete product?');">
                                        <input type="hidden" name="id" value="@prod.Id" />
                                        <button type="submit" class="text-rose-500 hover:text-rose-700 bg-rose-50 px-3 py-1.5 rounded-xl font-bold text-xs"><i class="fa-solid fa-trash-can"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </main>
</body>
</html>